# Default provider: Google Gemini (native google-genai SDK)
WORKER_PROVIDER=gemini
GEMINI_API_KEY=
WORKER_MODEL=gemini-flash-latest

# Alternatives:
# WORKER_PROVIDER=anthropic   ANTHROPIC_API_KEY=...   WORKER_MODEL=<anthropic model id>
# WORKER_PROVIDER=openai      OPENAI_API_KEY=...      OPENAI_BASE_URL=...   WORKER_MODEL=...

SANDBOX_URL=http://127.0.0.1:8001
